# --- FlashReserve environment (safe local defaults; copy to .env) ---

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flashreserve
POSTGRES_USER=flashreserve
POSTGRES_PASSWORD=flashreserve_local_dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/flashreserve
SPRING_DATASOURCE_USERNAME=flashreserve
SPRING_DATASOURCE_PASSWORD=flashreserve_local_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Reservation behavior
HOLD_DURATION_SECONDS=120
EXPIRATION_SCAN_INTERVAL_MS=1000
EXPIRATION_BATCH_SIZE=100

# Rate limiting (per user)
RATE_LIMIT_RESERVATIONS_PER_MINUTE=30
RATE_LIMIT_BURST=10

# Outbox publisher
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_MAX_RETRIES=10

# Mock payment gateway (probability weights, must sum to 1.0)
PAYMENT_SUCCESS_WEIGHT=0.85
PAYMENT_FAILURE_WEIGHT=0.10
PAYMENT_TIMEOUT_WEIGHT=0.05

# App
# 8081: 8080 is commonly claimed by local k8s/kind tooling; this project uses 8081.
SERVER_PORT=8081
LOGGING_LEVEL_COM_FLASHRESERVE=INFO
