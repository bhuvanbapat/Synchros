# --- synchros environment (safe local defaults; copy to .env) ---

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=synchros
POSTGRES_USER=synchros
POSTGRES_PASSWORD=synchros_local_dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/synchros
SPRING_DATASOURCE_USERNAME=synchros
SPRING_DATASOURCE_PASSWORD=synchros_local_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Reservation behavior
HOLD_DURATION_SECONDS=120
EXPIRATION_SCAN_INTERVAL_MS=1000
EXPIRATION_BATCH_SIZE=100

# Rate limiting (per user)
RATE_LIMIT_RESERVATIONS_PER_MINUTE=30
RATE_LIMIT_BURST=10

# Outbox publisher
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_MAX_RETRIES=10

# Mock payment gateway (probability weights, must sum to 1.0)
PAYMENT_SUCCESS_WEIGHT=0.85
PAYMENT_FAILURE_WEIGHT=0.10
PAYMENT_TIMEOUT_WEIGHT=0.05

# App
# 8081: 8080 is commonly claimed by local k8s/kind tooling; this project uses 8081.
SERVER_PORT=8081
LOGGING_LEVEL_COM_synchros=INFO

# Auth — JWT (HS256; use 32+ random chars in real deployments; rotate per env)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_TTL_SECONDS=3600

# Payment webhook HMAC shared secret (32+ random chars; differs per env)
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me-0123456789

# Webhook replay window (seconds): deliveries older than this are rejected
# even with a valid signature. Default 300 = 5 minutes.
PAYMENT_WEBHOOK_REPLAY_TOLERANCE_SECONDS=300

# Secret policy: refuse the repo's documented placeholder secrets under
# prod-like Spring profiles (fail-closed boot). false = demo machines only.
SECRET_POLICY_ENFORCE_NON_DEV=true

# OpenTelemetry (opt-in): set an endpoint to export traces over OTLP/HTTP.
# Empty (default) = no exporter, tracing dormant, zero overhead — the
# endpoint itself is the on/off switch (no separate enable flag).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLING_PROBABILITY=1.0

# Dev-only span probe (POST /api/dev/span-probe, JWT-protected): emits one
# SDK span to verify collector wiring. false for production; used by the
# tracing verification drill.
SPAN_PROBE_ENABLED=false
